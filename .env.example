# 本地开发 docker compose 使用的配置。
# 首次执行 ./dev.sh up 时会复制成 .env，并把所有 change-me 替换成随机值。
# .env 只用于本机，不要提交；线上密钥走 KMS / Vault。

COMPOSE_PROJECT_NAME=xsite

# ---------- PostgreSQL 18 ----------
PG_PORT=5432
POSTGRES_PASSWORD=change-me
XSITE_DB=xsite
XSITE_APP_USER=xsite_app
XSITE_APP_PASSWORD=change-me
XSITE_RO_USER=xsite_ro
XSITE_RO_PASSWORD=change-me

# ---------- Valkey 9 ----------
VALKEY_PORT=6379
VALKEY_PASSWORD=change-me

# ---------- 对象存储（SeaweedFS S3 兼容） ----------
S3_PORT=8333
S3_ACCESS_KEY=xsite-local
S3_SECRET_KEY=change-me
S3_BUCKET_MEDIA=xsite-media
S3_BUCKET_ASSETS=xsite-assets

# ---------- 本地资源机 FTP（./dev.sh up --ftp 时启动） ----------
# 后台登记资源机时凭据标识填 LOCAL：worker 从 FTP_LOCAL_USER / FTP_LOCAL_PASSWORD 读取账号密码
FTP_LOCAL_USER=xsite
FTP_LOCAL_PASSWORD=change-me

# ---------- 链路追踪（Jaeger，--obs 时启动） ----------
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# ---------- 应用 ----------
# 端口监听地址。默认只监听本机；真机调试 APP 时改成 0.0.0.0（同时只在可信局域网使用）
BIND_ADDR=127.0.0.1
SERVICE_PORT=8080
APPS_PORT=3001
ADMIN_PORT=5173
# 反馈社区 H5/PC 前台（feedback/，Next.js）
FEEDBACK_PORT=3002
# BFF 调后端的服务令牌（本地随机）
BFF_SERVICE_TOKEN=change-me
# 回源共享密钥（本地随机）
EDGE_SHARED_SECRET=change-me
# 用户端接口报文加密密钥种子（本地随机）。compose 中组装成 API_ENC_KEYS=dev1:<种子>
API_ENC_SECRET=change-me
# HLS 内容密钥的包装密钥种子（本地随机，S1-5）。compose 中组装成 MEDIA_KEKS=dev1:<种子>
MEDIA_KEK_SECRET=change-me
# 存储源凭据的包装密钥种子（本地随机，S1-6a）。compose 中组装成 STORAGE_KEKS=dev1:<种子>
STORAGE_KEK_SECRET=change-me
# 线路的媒体签名密钥种子（本地随机，S1-6e）。compose 中组装成 LINE_SIGN_KEYS=dev-cdn:<种子>，
# 线路的「密钥引用」填 dev-cdn 即可用 hmac_token 签名；线上由密钥管理同时下发给 service 与 CDN 边缘
LINE_SIGN_SECRET=change-me
# 后台图片优化的 Tinify（tinypng.com）API Key，只在服务端使用、不下发浏览器（docs/03 第 9.6a 节）。
# 留空时后台图片上传退回浏览器本地 canvas 压缩，功能降级但不影响启动。申请：https://tinypng.com/developers
IMAGE_TINIFY_API_KEY=
# 压缩结果的最长边（像素），超过时按比例缩小
IMAGE_MAX_SIDE=2400
# 孤立产物的保留期与清理周期（S1-6f）。分集删除或重新转封装后产物不再被引用，过保留期才连同
# 各存储源上的文件一起删除。本地默认缩短到 1 小时方便验证；production 不应短于 168h（7 天）
MEDIA_ORPHAN_RETENTION=1h
MEDIA_CLEANUP_INTERVAL=24h
# GeoIP 数据库路径（S1-6c）。本地默认用 mediatool geoip-sample 生成的小数据集：
#   ./dev.sh run service go run ./cmd/mediatool geoip-sample -out /app/testdata/geoip/ip2region.xdb
# 线上换成 ip2region 官方的 xdb 文件（挂进容器后改这个路径）。留空则地区一律未知，只匹配全局兜底线路
GEOIP_XDB_PATH=/app/testdata/geoip/ip2region.xdb
GEOIP_RELOAD_INTERVAL=10m
# 播放令牌的签名密钥种子（本地随机，S1-7）。compose 中组装成 PLAY_TOKEN_KEYS=dev1:<种子>；只有 service 签发与校验
PLAY_TOKEN_SECRET=change-me
# 用户端 Access Token（JWT/EdDSA）的签名密钥种子（本地随机，S1-10）。compose 中组装成 JWT_SIGNING_KEYS=dev1:<种子>；只有 API 签发与校验
JWT_SIGNING_SECRET=change-me
# 配置备份的签名密钥种子（本地随机，S4-4）。compose 中组装成 CONFIG_BACKUP_KEYS=dev1:<种子>。
# 备份文件是明文 JSON，用签名保证「没被手改过」：导出时签、导入时验。留空则不签不验（任何人构造一份备份都能导进来），
# 所以非开发环境必须配置
CONFIG_BACKUP_SECRET=change-me
# 后台二次验证 TOTP 种子的包装密钥种子（S2-6）。compose 中组装成 ADMIN_TOTP_KEKS=dev1:<种子>。
# 后台用户绑定 TOTP 时用它信封加密保存种子；留空时 compose 用固定开发默认值，production 必须配置
ADMIN_TOTP_KEK_SECRET=change-me
