{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-perf", "unicorn", "oxc", "import", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "react/set-state-in-effect": "warn",
    "react/incompatible-library": "warn",
    "jsx-a11y/prefer-tag-over-role": "warn",
    "import/no-unassigned-import": "off",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          { "name": "axios", "message": "请使用 src/lib/http.ts（docs/06 第 0.3 节）" },
          { "name": "crypto-js", "message": "请使用 Web Crypto API" },
          { "name": "@tremor/react", "message": "请使用 shadcn charts（Recharts）" }
        ]
      }
    ]
  },
  "ignorePatterns": ["src/routeTree.gen.ts", "src/components/ui/**", "dist"]
}
