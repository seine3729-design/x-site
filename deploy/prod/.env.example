# 生产配置模板。复制成服务器上的 deploy/prod/.env 后填值，权限设 600。
#
#   这个文件只有示例值，不含任何真实密钥。.env 不进仓库、不进镜像、不进 CI 日志。
#   密钥生成：openssl rand -hex 32   （得到 64 个字符，满足所有「至少 32 字符」的校验）
#
# 带「必填」的项缺失时 docker compose 会直接报错，不会带着危险默认值把服务起起来。

# ---------- 发布 ----------
# 镜像仓库前缀。GitHub Actions 推到 GHCR，形如 ghcr.io/<账号>/x-site
IMAGE_PREFIX=ghcr.io/example/x-site
# 本次部署的镜像标签，由发布流程写入（git 短 SHA）
RELEASE_TAG=latest

# ---------- 域名 ----------
# 用户端前台
APPS_DOMAIN=duanju66.cc
# 用户端别名，空格分隔，会 301 跳到 APPS_DOMAIN。留空则不生成这个 server 块
APPS_ALIASES=www.duanju66.cc
# 运营后台（与用户端域名、证书、入口完全分离，docs/00 第 2 节）
ADMIN_DOMAIN=admin.duanju66.cc
# 反馈社区前台。
#
# 【待确认】需求里给的是 feedback.duanju.cc（duanju.cc），而前台与后台在 duanju66.cc，
# 两者不是同一个一级域。这里先按同域写成 feedback.duanju66.cc，要用 duanju.cc 的话改这一行即可
# —— 但那需要 duanju.cc 也解析到本机，证书也会单独签一张。
FEEDBACK_DOMAIN=feedback.duanju66.cc
# 证书到期提醒邮箱（Let's Encrypt 必填）
CERTBOT_EMAIL=ops@example.com
# 演练发布流程时设 1：用 Let's Encrypt staging 签发，证书不受信但不占正式环境的频率额度
CERTBOT_STAGING=0

# ---------- 静态资源 CDN（R2） ----------
# 静态资源域名固定为 https://cdn.duanju66.cc（R2 桶 duanju666 的自定义域）。
#
# 下面这几项只在 CI 构建镜像时用（写进前端产物），服务器上的 .env 不需要它们；
# 列在这里是为了让「线上到底用的哪个 CDN 域名」有一个地方可查：
#   CDN_BASE=https://cdn.duanju66.cc      仓库变量，不设就用上面这个默认值
#   R2_BUCKET=duanju666                   仓库变量
#   R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY  放 GitHub Secrets
#
# apps 不用独立 CDN 域名：它的边缘加速靠把 APPS_DOMAIN 整体挂到 Cloudflare 代理后面
# （原因见 deploy/prod/README.md 第 4 节）。那种模式下 EDGE_TRUST_CLOUDFLARE 必须是 1。

# 边缘层是否信任 Cloudflare 的回源网段，并用 CF-Connecting-IP 作为客户端 IP。
# 站点域名挂在 Cloudflare 代理（橙云）后面时必须是 1，否则限流和风控会把所有访客当成同一个来源。
# 完全不经代理、浏览器直连本机时设 0。
EDGE_TRUST_CLOUDFLARE=1

# ---------- PostgreSQL ----------
PG_PORT=5432
POSTGRES_PASSWORD=
XSITE_DB=xsite
XSITE_APP_USER=xsite_app
XSITE_APP_PASSWORD=
XSITE_RO_USER=xsite_ro
XSITE_RO_PASSWORD=
# 按机器内存调整：shared_buffers 约为内存的 25%，effective_cache_size 约 75%
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB

# 后端连接串。用 compose 内的 postgres 时 sslmode=disable 可以接受（流量不出主机）；
# 换成托管实例必须 sslmode=verify-full（docs/00 第 3.5 节）
DATABASE_URL=postgres://xsite_app:填上面的密码@postgres:5432/xsite?sslmode=disable
DATABASE_RO_URL=postgres://xsite_ro:填上面的密码@postgres:5432/xsite?sslmode=disable

# ---------- Valkey ----------
VALKEY_PASSWORD=
VALKEY_MAXMEMORY=1gb
# 0 号库给后端，1 号库给 apps 的 BFF（限流与会话计数），刻意分开
VALKEY_URL=redis://:填上面的密码@valkey:6379/0
APPS_VALKEY_URL=redis://:填上面的密码@valkey:6379/1

# ---------- 对象存储（媒体，docs/12） ----------
# R2 的 endpoint 形如 https://<账户ID>.r2.cloudflarestorage.com；region 固定 auto，不用 path style
S3_ENDPOINT=https://账户ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY=
S3_SECRET_KEY=
# HLS 产物桶（经视频线路分发）
S3_BUCKET_MEDIA=xsite-media
# 图片等公开资源桶（首帧图、封面）
S3_BUCKET_ASSETS=xsite-assets
# 私有入库桶。启动校验要求它不等于 S3_BUCKET_ASSETS（公开读的桶不能当入库桶）；
# 也不要和前端静态产物的 CDN 桶混用，那是两条独立的通道
MEDIA_SOURCE_BUCKET=xsite-source

# ---------- 服务令牌与密钥（docs/10） ----------
# 每一项都用 openssl rand -hex 32 单独生成，不要复用同一个值。
# 轮换方式：在列表最前面加一把新的，保留旧的一段时间（第一把用于签发，全部用于校验）。

# apps / feedback 的服务端调后端时携带（至少 32 字符）
BFF_SERVICE_TOKEN=
# 边缘层回源时携带 x-edge-secret，拦掉绕过边缘直连源站的请求（至少 32 字符）
EDGE_SHARED_SECRET=
# 用户端接口报文加密，格式 kid:secret[,...]
API_ENC_KEYS=k1:
# 用户端 Access Token 签名
JWT_SIGNING_KEYS=k1:
# 播放令牌签名（只有 API 签发与校验，不下发给 CDN）
PLAY_TOKEN_KEYS=k1:
# HLS 内容密钥的包装密钥
MEDIA_KEKS=k1:
# 存储源凭据的包装密钥（后台保存存储源凭据时信封加密）
STORAGE_KEKS=k1:
# 线路的媒体签名密钥。要同时下发给 service 与 CDN 边缘，线路的 sign_key_ref 指向其中一项
LINE_SIGN_KEYS=cdn1:
# 配置备份的签名密钥。留空则导出不签名、导入也不验签 —— 那样任何人构造一份备份都能导进来
CONFIG_BACKUP_KEYS=k1:
# 后台二次验证 TOTP 种子的包装密钥。production 必填
ADMIN_TOTP_KEKS=k1:

# ---------- 运行参数 ----------
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=20s
# 只采信来自这些网段的 X-Forwarded-For。默认是 compose 的 bridge 网段；
# 写得过宽等于让任何人伪造客户端 IP
TRUSTED_PROXIES=172.16.0.0/12
# 转封装并发。按 CPU 核数给，太大反而因为抢 CPU 变慢
MEDIA_TRANSCODE_CONCURRENCY=1
# 后台图片上传的服务端压缩（Tinify，https://tinypng.com/developers）。只到 service，不进前端产物。
# 留空时后台退回浏览器本地压缩（画质与体积都更差），不影响启动。免费额度 500 次/月，
# 一张需要转格式或缩尺寸的图消耗 2 次
IMAGE_TINIFY_API_KEY=
# 压缩结果的最长边（像素）
IMAGE_MAX_SIDE=2400
# 孤立产物保留期。production 不应短于 168h（7 天）
MEDIA_ORPHAN_RETENTION=720h
MEDIA_CLEANUP_INTERVAL=24h
# GeoIP 数据文件（ip2region xdb）。放到服务器的 deploy/prod/geoip/ 目录下；
# 没有这个文件时地区一律按未知处理，只有全局兜底线路会命中
GEOIP_XDB_PATH=/data/geoip/ip2region.xdb
GEOIP_RELOAD_INTERVAL=10m

# 资源机账号密码（只注入 media-worker，按后台登记的凭据标识命名）
FTP_LOCAL_USER=
FTP_LOCAL_PASSWORD=

# ---------- 前端运行期配置 ----------
# 图片线路域名的**补充**，逗号分隔、不带末尾斜杠。
#
# 后台存储线路表里的域名已经随 /api/v1/site-config 的 media 段下发、CSP 按请求生成（契约 0.77.0），
# 所以后台新增 / 修改线路不需要再同步这里，也不用重启容器。
# 这里只负责线路表管不到的那类域名：后台把 Logo、favicon、封面填成 https://cdn.duanju66.cc/... 的完整地址
# （admin 与 feedback 的品牌 Logo 已经这么用），不登记的话前台 CSP 会把它拦掉、一张图都不出。
IMAGE_BASE_URLS=https://cdn.duanju66.cc
# 视频切片线路域名池，逗号分隔。hls.js 用 XHR 取切片，不在这里登记的域名生产环境放不出视频。
# 这里填的是后台线路表里 kind=video 的访问域名，和上面的图片域名经常不是同一批
MEDIA_CONNECT_ORIGINS=https://cdn.duanju66.cc

# ---------- 可观测（可选） ----------
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
