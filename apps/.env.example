# 两套环境分别放在已提交的文件里：
# .env.development  开发，bun run dev / bun run build:dev
# .env.production   线上，bun run build / bun run start
#
# 密钥不要写进上面两个文件。本地放 .env.local，某一套的差异放
# .env.development.local、.env.production.local。这几个文件不会提交。
# 加载顺序是环境文件、.env.local、再是 .env.<环境>.local，后面的覆盖前面的。

# 当前环境标识，只在服务端读取。development 或 production
APP_ENV=development
# 打进浏览器脚本的环境标识，构建时写入
PUBLIC_APP_ENV=development
# 开发环境可写固定站点地址。线上不配置，绝对链接用当次请求的 Host。不要带末尾斜杠
PUBLIC_SITE_URL=http://localhost:3001

# 静态资源 CDN 前缀，不要带末尾斜杠，例如 https://cdn.example.com/apps。留空则产物从本站加载。
# 构建期生效：改了必须重新构建。线上值由部署编排的构建参数注入
CDN_ASSET_PREFIX=

# 配置后，只有携带相同 x-edge-secret 的请求才能使用 CDN 写入的国家头
EDGE_SHARED_SECRET=

# 下面两个域名池的**主来源是后台存储线路表**，随 /api/v1/site-config 的 media 段下发（契约 0.77.0，docs/04 F）：
# 封面等相对 key 用它拼完整地址，生产 CSP 的 connect-src 也按请求用它生成。换线路不用改这里、也不用重启。
# 这两个变量只是补充，一般留空。需要填的唯一情况：后台把封面 / Logo / 广告图填成了某个**不在线路表里**的
# 完整地址，那个域名要登记进来，生产 CSP 才不会拦掉它。逗号分隔、不要带末尾斜杠。
# 线路必须对站点域名返回 CORS 头（页面用 fetch 取图转 blob: 显示）
IMAGE_BASE_URLS=

# 同上，视频切片的补充域名（hls.js 用 XHR 取切片；清单与密钥是本站地址，不受影响）。本地开发不设置也能播
MEDIA_CONNECT_ORIGINS=

# 图片按显示尺寸缩放（docs/08 第 5 节）：列出的图片线路域名上的图，经站点自己所在 Cloudflare 区域的
# /cdn-cgi/image/ 实时转成对应宽度（同源请求，不需要 CORS）。逗号分隔。留空不缩放、一律用原图。
# 本地开发留空（localhost 前面没有 Cloudflare）；线上由 apps/docker-compose.yml 注入 https://cdn.duanju66.cc。
# 前提：站点域名的 Cloudflare 区域开着 Images → Transformations（docs/14 第 4.2 节）
IMAGE_RESIZE_ORIGINS=

# 页面请求每分钟配额
RATE_LIMIT_PAGE_PER_MIN=300
# 读接口每分钟配额
RATE_LIMIT_READ_PER_MIN=120
# 写接口每分钟配额
RATE_LIMIT_WRITE_PER_MIN=30
# 自动化客户端每分钟配额
RATE_LIMIT_BOT_PER_MIN=20
