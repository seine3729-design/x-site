# 开发环境标识
APP_ENV=development

# 打进浏览器脚本的环境标识，构建时写入
PUBLIC_APP_ENV=development
# 开发环境地址
PUBLIC_SITE_URL=http://localhost:3001

# 静态资源 CDN 域名
CDN_ASSET_PREFIX=

# 页面请求每分钟配额。开发环境放宽，避免本地调试被限流
RATE_LIMIT_PAGE_PER_MIN=2000
# 读接口每分钟配额
RATE_LIMIT_READ_PER_MIN=600
# 写接口每分钟配额
RATE_LIMIT_WRITE_PER_MIN=120
# 自动化客户端每分钟配额
RATE_LIMIT_BOT_PER_MIN=60
