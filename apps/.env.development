# 开发环境标识
APP_ENV=development

# 打进浏览器脚本的环境标识，构建时写入
PUBLIC_APP_ENV=development
# 开发环境地址
PUBLIC_SITE_URL=http://localhost:3001

# 静态资源 CDN 域名
CDN_ASSET_PREFIX=

# 图片线路域名：现在由后台存储线路表随 /api/v1/site-config 的 media 段下发（契约 0.77.0，docs/04 F），
# 这里只是**补充**，留空即可。需要填的只有一种情况：后台把封面 / Logo 填成了不在线路表里的完整地址，
# 那个域名要登记进来，生产环境的 CSP 才不会拦掉它（本地开发不发 CSP，更不需要填）。
IMAGE_BASE_URLS=

# 页面请求每分钟配额。开发环境放宽，避免本地调试被限流
RATE_LIMIT_PAGE_PER_MIN=2000
# 读接口每分钟配额
RATE_LIMIT_READ_PER_MIN=600
# 写接口每分钟配额
RATE_LIMIT_WRITE_PER_MIN=120
# 自动化客户端每分钟配额
RATE_LIMIT_BOT_PER_MIN=60
