# 线上环境标识
APP_ENV=production

# 打进浏览器脚本的环境标识，构建时写入
PUBLIC_APP_ENV=production

# 静态资源 CDN 域名。
#
# 留空是刻意的：本站有 Service Worker（docs/04 D 节的离线兜底与资源缓存），
# 而 SvelteKit 不允许它和 paths.assets 同时存在 —— 填了这一项，`bun run build` 会直接报
# service_worker_assets「Cannot use service worker alongside config.paths.assets」并失败。
#
# 想让静态资源走 CDN，用反向代理型 CDN 把站点域名整体套在边缘后面，
# 让 /_app/immutable/* 在同源地址上被边缘缓存（产物已带 immutable 长缓存头与预压缩文件）。
# 要改成独立 CDN 域名，就得先决定去掉 Service Worker —— 那是产品取舍，不是部署配置。
CDN_ASSET_PREFIX=

# 页面请求每分钟配额
RATE_LIMIT_PAGE_PER_MIN=300
# 读接口每分钟配额
RATE_LIMIT_READ_PER_MIN=120
# 写接口每分钟配额
RATE_LIMIT_WRITE_PER_MIN=30
# 自动化客户端每分钟配额
RATE_LIMIT_BOT_PER_MIN=20
