# 线上环境标识
APP_ENV=production

# 打进浏览器脚本的环境标识，构建时写入
PUBLIC_APP_ENV=production

# 静态资源 CDN 前缀（带内容哈希的 /_app/immutable/* 从这里加载），不要带末尾斜杠。
#
# 这里留空、由部署时注入，是刻意的：填了之后 `bun run build` 的产物会把资源地址写成这个域名下的
# 绝对地址，而本机构建出来的那批文件并没有上传到 CDN，`bun run start` 直接打不开。
# 线上由 apps/docker-compose.yml 的构建参数写进 .env.production.local（加载顺序在本文件之后）。
#
# 注意这是**构建期**决定的：改 CDN 域名必须重新构建，只改运行期环境变量不生效。
# 同一个值还会被 config/security-headers.ts 拼进生产 CSP，以及被 scripts/build-sw.ts 注入
# Service Worker（它据此识别产物请求）—— 三处共用一个变量，不会配歪。
#
# Service Worker 与 paths.assets 的冲突已经解决：SW 搬到了 src/sw/、由 scripts/build-sw.ts
# 自己编译，不再受 SvelteKit 的 service_worker_assets 校验限制（见那个脚本的注释）。
CDN_ASSET_PREFIX=

# 页面请求每分钟配额
RATE_LIMIT_PAGE_PER_MIN=300
# 读接口每分钟配额
RATE_LIMIT_READ_PER_MIN=120
# 写接口每分钟配额
RATE_LIMIT_WRITE_PER_MIN=30
# 自动化客户端每分钟配额
RATE_LIMIT_BOT_PER_MIN=20
