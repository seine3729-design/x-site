# 测试环境标识
APP_ENV=test

# 打进浏览器脚本的环境标识，构建时写入
PUBLIC_APP_ENV=test

# 测试环境地址
PUBLIC_SITE_URL=http://localhost:3001

# 静态资源 CDN 域名
CDN_ASSET_PREFIX=

# 页面请求每分钟配额
RATE_LIMIT_PAGE_PER_MIN=300
# 读接口每分钟配额
RATE_LIMIT_READ_PER_MIN=120
# 写接口每分钟配额
RATE_LIMIT_WRITE_PER_MIN=30
# 自动化客户端每分钟配额
RATE_LIMIT_BOT_PER_MIN=20
